 = -150" line23="    } else if (controller.right.isPressed()) {" line24="        shockwave.vx = 150" line25="    } else {" line26="        shockwave.vx = 0" line27="    }" line28="" line29="    // 2. Evaluate Vertical Vector Components" line30="    if (controller.up.isPressed()) {" line31="        shockwave.vy = -150" line32="    } else if (controller.down.isPressed()) {" line33="        shockwave.vy = 150" line34="    } else {" line35="        shockwave.vy = 0" line36="    }" line37="" line38="    // 3. Fallback: If standing dead still, default to firing forwards (Right)" line39="    if (shockwave.vx == 0 &amp;&amp; shockwave.vy == 0) {" line40="        shockwave.vx = 150" line41="    }" line42="})" numlines="43"></mutation></block><block type="variables_get" id="JMz^jIRfq;z*`]AuI6+6" disabled-reasons="pxt_automatic_disabled" x="20" y="3901"><field name="VAR" id="ZC`^o179vdx8BX$+1K4L">mySprite</field></block><block type="variables_get" id="nlwz|`4vpF{Lk-ZVPA2c" disabled-reasons="pxt_automatic_disabled" x="179" y="3901"><field name="VAR" id="tn%dU~y_Ur^qEiD]^}kZ">shark</field></block></xml>